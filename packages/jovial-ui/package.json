{
  "name": "@jienix/jovial-ui",
  "version": "1.0.0",
  "description": "Jovial UI Components Library",
  "author": "jienix",
  "license": "MIT",
  "keywords": [
    "vue3",
    "components",
    "ui"
  ],
  "sideEffects": [
    "dist/*",
    "lib/*",
    "esm/*",
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.full.min.js",
      "require": "./dist/index.full.min.js",
      "default": "./dist/index.full.min.js"
    }
  },
  "main": "lib/index.cjs",
  "module": "esm/index.js",
  "unpkg": "dist/index.full.min.js",
  "jsdelivr": "dist/index.full.min.js",
  "types": "types/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build"
  },
  "peerDependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@jienix/jovial-components": "workspace:*",
    "@jienix/jovial-directives": "workspace:*",
    "@jienix/jovial-framework": "workspace:*",
    "@jienix/jovial-locale": "workspace:*",
    "@jienix/jovial-theme": "workspace:*",
    "@jienix/utils": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
