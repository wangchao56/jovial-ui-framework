{
  "compilerOptions": { // 包含标准库文件
    "target": "ES2020",
    "jsx": "preserve", // 启用 CommonJS 与 ES 模块之间的互操作支持
    "jsxImportSource": "vue", // 为调试生成源映射
    "lib": ["ESNext", "DOM", "DOM.Iterable", "ES2020"], // 保持 JSX 原样（用于 React）
    "noLib": false, // 允许从没有默认导出的模块中导入默认值
    "experimentalDecorators": true,
    "module": "ESNext", // 在输出中移除注释
    "moduleResolution": "node", // 禁止对同一文件的不一致的大小写引用
    "resolveJsonModule": true, // 允许导入 JSON 模块
    "strict": true, // 不生成声明文件
    "noImplicitAny": false, // 设置模块类型为 ESNext
    "declaration": false, // 允许不明确标注类型的变量，默认使用 any 类型
    "removeComments": true, // 编译到 ES6 标准
    "sourceMap": true, // 指定要包括的库文件
    "allowSyntheticDefaultImports": true, // 使用 Node.js 风格的模块解析
    "esModuleInterop": true, // 启用对装饰器的实验性支持
    "forceConsistentCasingInFileNames": true, // 启用所有严格的类型检查选项
    "skipLibCheck": true // 跳过对声明文件的类型检查
  },
  "exclude": [
    // 在编译时排除这些路径
    "node_modules",
    "**/_tests_",
    "dist/"
  ]
}
