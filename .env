# 组件库名称
COMPONENT_NAME = jovial-ui

# 打包输出目录

OUTPUT_DIR = build/jovial-ui


# 组件库根目录
PKG_ROOT = packages/jovial

# 组件所在目录

COMPONENTS_DIR = packages/jovial/src/components


# 组件库版本
COMPONENT_VERSION = 0.0.1

# 组件库描述
COMPONENT_DESCRIPTION = 一个基于 Vue 3 的组件库

# 组件库作者
COMPONENT_AUTHOR = jieni

# 组件库仓库地址
COMPONENT_REPO = https://github.com/jieni/jovial-ui

# 组件库许可证
COMPONENT_LICENSE = MIT

# 组件库主页
COMPONENT_HOMEPAGE = https://jieni.github.io/jovial-ui

# 组件库依赖
COMPONENT_DEPENDENCIES = vue@3.5.13

